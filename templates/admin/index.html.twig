{% extends 'base.html.twig' %}

{% block title %}Admin Panel &middot; TechBazaar{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <!-- Header banner -->
    <div class="bg-gradient-to-r from-amber-500 to-amber-700 rounded-3xl p-6 sm:p-8 text-white shadow-md mb-8">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white mb-2">
                    🛡️ Protected Zone (ROLE_ADMIN)
                </div>
                <h1 class="text-3xl font-extrabold tracking-tight">Admin Dashboard</h1>
                <p class="mt-1 text-amber-100 text-sm">
                    Logged in as <strong>{{ user.userIdentifier }}</strong>
                </p>
            </div>
            <div class="flex items-center space-x-2">
                <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-bold bg-green-500 text-white">
                    Access Granted: HTTP 200
                </span>
            </div>
        </div>
    </div>

    <!-- Admin Content Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Products & Categories Card -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center space-x-3 mb-4">
                <span class="text-2xl">📦</span>
                <h2 class="text-lg font-bold text-gray-900">Catalog Management (A9)</h2>
            </div>
            <p class="text-sm text-gray-600 mb-4">
                Manage products and categories for TechBazaar.
            </p>
            <div class="space-y-2">
                <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-md">Products CRUD</span>
                <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-md">Categories CRUD</span>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center space-x-3 mb-4">
                <span class="text-2xl">🧾</span>
                <h2 class="text-lg font-bold text-gray-900">Orders Management (A9)</h2>
            </div>
            <p class="text-sm text-gray-600 mb-4">
                View orders and update their fulfillment and shipping status.
            </p>
            <div class="space-y-2">
                <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-md">Order List</span>
                <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-md">Status Transition</span>
            </div>
        </div>
    </div>

    <!-- Demo Checklist -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-2xl p-6 text-sm text-blue-900">
        <h3 class="font-bold text-base mb-2">📋 Demo 2 · Server-side Security Verification:</h3>
        <ul class="list-disc list-inside space-y-1 text-blue-800">
            <li>Customer account (<code class="bg-blue-100 px-1 py-0.5 rounded">ROLE_USER</code>) visiting <code class="bg-blue-100 px-1 py-0.5 rounded">/admin</code> gets <strong>HTTP 403 Access Denied</strong>.</li>
            <li>Admin account (<code class="bg-blue-100 px-1 py-0.5 rounded">ROLE_ADMIN</code>) visiting <code class="bg-blue-100 px-1 py-0.5 rounded">/admin</code> successfully loads this dashboard (<strong>HTTP 200</strong>).</li>
            <li>Enforced by both Symfony security <code class="bg-blue-100 px-1 py-0.5 rounded">access_control</code> and controller <code class="bg-blue-100 px-1 py-0.5 rounded">#[IsGranted('ROLE_ADMIN')]</code>.</li>
        </ul>
    </div>
</div>
{% endblock %}
