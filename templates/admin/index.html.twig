{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard &middot; TechBazaar{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto space-y-8">
    <!-- Header banner -->
    <div class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-3xl p-6 sm:p-10 text-white shadow-md">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-400/30 mb-2">
                    🛡️ Administrator
                </span>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Admin Dashboard</h1>
                <p class="mt-1 text-slate-300 text-sm">
                    Logged in as <strong>{{ user.userIdentifier }}</strong>
                </p>
            </div>
            <div class="flex items-center space-x-3">
                <a href="{{ path('app_home') }}" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-semibold transition border border-white/20">
                    Store Front
                </a>
                <a href="{{ path('app_logout') }}" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-semibold transition">
                    Sign Out
                </a>
            </div>
        </div>
    </div>

    <!-- Admin Content Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Products & Categories Card -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center space-x-3 mb-4">
                <span class="text-3xl">📦</span>
                <div>
                    <h2 class="text-lg font-bold text-gray-900">Catalog & Products</h2>
                    <p class="text-xs text-gray-500">Categories and inventory</p>
                </div>
            </div>
            <p class="text-sm text-gray-600 mb-6">
                Manage product listings, pricing, descriptions, specifications, and category taxonomy.
            </p>
            <div class="flex gap-2">
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Products</span>
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Categories</span>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center space-x-3 mb-4">
                <span class="text-3xl">🧾</span>
                <div>
                    <h2 class="text-lg font-bold text-gray-900">Orders & Fulfillment</h2>
                    <p class="text-xs text-gray-500">Customer purchases</p>
                </div>
            </div>
            <p class="text-sm text-gray-600 mb-6">
                Review incoming orders, check payment status, and update shipment status transitions.
            </p>
            <div class="flex gap-2">
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Pending</span>
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Paid</span>
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Shipped</span>
            </div>
        </div>

        <!-- Customers Card -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition">
            <div class="flex items-center space-x-3 mb-4">
                <span class="text-3xl">👥</span>
                <div>
                    <h2 class="text-lg font-bold text-gray-900">User Accounts</h2>
                    <p class="text-xs text-gray-500">Registered members</p>
                </div>
            </div>
            <p class="text-sm text-gray-600 mb-6">
                View registered customer profiles, security roles, and active accounts across the store.
            </p>
            <div class="flex gap-2">
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Customers</span>
                <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-700 rounded-lg">Roles</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
