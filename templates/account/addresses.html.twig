{% extends 'base.html.twig' %}

{% block title %}Delivery Addresses &middot; TechBazaar{% endblock %}

{% block body %}
<main class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Saved Delivery Addresses</h1>
        <p class="mt-1 text-sm text-slate-600">
            Manage your shipping destinations for fast checkout.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-slate-200 shadow-xs">
            <h2 class="text-base font-bold text-slate-900 mb-4">
                Add New Address
            </h2>

            {{ form_start(addressForm, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(addressForm.street, 'Street Address', {'label_attr': {'class': 'block text-xs font-semibold text-slate-600 mb-1'}}) }}
                    {{ form_widget(addressForm.street, {'attr': {'class': 'w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900'}}) }}
                    {% if form_errors(addressForm.street) %}
                        <div class="mt-1 text-xs text-rose-600">{{ form_errors(addressForm.street) }}</div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(addressForm.city, 'City', {'label_attr': {'class': 'block text-xs font-semibold text-slate-600 mb-1'}}) }}
                    {{ form_widget(addressForm.city, {'attr': {'class': 'w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900'}}) }}
                    {% if form_errors(addressForm.city) %}
                        <div class="mt-1 text-xs text-rose-600">{{ form_errors(addressForm.city) }}</div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(addressForm.phone, 'Phone Number', {'label_attr': {'class': 'block text-xs font-semibold text-slate-600 mb-1'}}) }}
                    {{ form_widget(addressForm.phone, {'attr': {'class': 'w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900'}}) }}
                    {% if form_errors(addressForm.phone) %}
                        <div class="mt-1 text-xs text-rose-600">{{ form_errors(addressForm.phone) }}</div>
                    {% endif %}
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-xs text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 transition">
                        Save Address
                    </button>
                </div>
            {{ form_end(addressForm) }}
        </div>

        <div class="space-y-4">
            <h2 class="text-base font-bold text-slate-900">
                Your Addresses ({{ addresses|length }})
            </h2>

            {% if addresses is empty %}
                <div class="bg-white border border-dashed border-slate-300 rounded-xl p-8 text-center text-sm text-slate-500">
                    <p class="font-medium text-slate-700">No delivery addresses saved yet.</p>
                    <p class="text-xs text-slate-400 mt-1">Use the form to add your primary delivery location.</p>
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for addr in addresses %}
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs flex justify-between items-start">
                            <div class="space-y-1">
                                <p class="font-semibold text-slate-900">{{ addr.street }}</p>
                                <p class="text-sm text-slate-600">{{ addr.city }}</p>
                                <p class="text-xs text-slate-500">
                                    {{ addr.phone }}
                                </p>
                            </div>
                            <form method="post" action="{{ path('app_account_address_delete', {'id': addr.id}) }}" onsubmit="return confirm('Delete this address?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-address-' ~ addr.id) }}">
                                <button type="submit" class="text-xs font-medium text-rose-600 hover:underline p-1">
                                    Delete
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
