{% extends 'base.html.twig' %}

{% block title %}Delivery Addresses &middot; TechBazaar{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Saved Delivery Addresses</h1>
        <p class="mt-1 text-sm text-gray-600">
            Manage your shipping destinations for fast checkout.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Add Address Form -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center space-x-2">
                <span>➕</span>
                <span>Add New Address</span>
            </h2>

            {{ form_start(addressForm, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(addressForm.street, 'Street Address', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(addressForm.street) }}
                    {% if form_errors(addressForm.street) %}
                        <div class="mt-1 text-xs text-red-600">{{ form_errors(addressForm.street) }}</div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(addressForm.city, 'City', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(addressForm.city) }}
                    {% if form_errors(addressForm.city) %}
                        <div class="mt-1 text-xs text-red-600">{{ form_errors(addressForm.city) }}</div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(addressForm.phone, 'Phone Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(addressForm.phone) }}
                    {% if form_errors(addressForm.phone) %}
                        <div class="mt-1 text-xs text-red-600">{{ form_errors(addressForm.phone) }}</div>
                    {% endif %}
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                        Save Address
                    </button>
                </div>
            {{ form_end(addressForm) }}
        </div>

        <!-- Saved Addresses List -->
        <div class="space-y-4">
            <h2 class="text-lg font-bold text-gray-900 flex items-center space-x-2">
                <span>📦</span>
                <span>Your Addresses ({{ addresses|length }})</span>
            </h2>

            {% if addresses is empty %}
                <div class="bg-gray-50 border border-dashed border-gray-300 rounded-2xl p-8 text-center text-sm text-gray-500">
                    <p class="text-2xl mb-2">🏠</p>
                    <p>No delivery addresses saved yet.</p>
                    <p class="text-xs text-gray-400 mt-1">Use the form to add your primary delivery location.</p>
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for addr in addresses %}
                        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex justify-between items-start">
                            <div class="space-y-1">
                                <p class="font-semibold text-gray-900">{{ addr.street }}</p>
                                <p class="text-sm text-gray-600">{{ addr.city }}</p>
                                <p class="text-xs text-gray-500 flex items-center space-x-1">
                                    <span>📞</span>
                                    <span>{{ addr.phone }}</span>
                                </p>
                            </div>
                            <form method="post" action="{{ path('app_account_address_delete', {'id': addr.id}) }}" onsubmit="return confirm('Delete this address?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-address-' ~ addr.id) }}">
                                <button type="submit" class="text-xs text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition" title="Delete">
                                    🗑️ Delete
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
