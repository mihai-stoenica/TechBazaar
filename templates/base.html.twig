<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TechBazaar{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚡</text></svg>">
        
        <!-- Tailwind CSS CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: {
                                50: '#eff6ff',
                                100: '#dbeafe',
                                500: '#3b82f6',
                                600: '#2563eb',
                                700: '#1d4ed8',
                                900: '#1e3a8a',
                            }
                        }
                    }
                }
            }
        </script>
        
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-full flex flex-col text-gray-900 font-sans antialiased">
        <!-- Navigation Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <!-- Logo / Brand -->
                    <div class="flex items-center space-x-3">
                        <a href="{{ path('app_home') }}" class="flex items-center space-x-2 text-xl font-bold text-gray-900 tracking-tight">
                            <span class="text-blue-600 text-2xl">⚡</span>
                            <span>TechBazaar</span>
                        </a>
                    </div>

                    <!-- Navigation Links -->
                    <nav class="flex items-center space-x-2 sm:space-x-4 text-sm font-medium">
                        <a href="{{ path('app_home') }}" class="px-3 py-2 rounded-md text-gray-700 hover:text-blue-600 hover:bg-gray-50 transition">Home</a>
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_index') }}" class="px-3 py-1.5 rounded-md bg-amber-100 text-amber-800 hover:bg-amber-200 font-semibold flex items-center space-x-1 transition">
                                <span>🛡️</span>
                                <span>Admin</span>
                            </a>
                        {% endif %}

                        {% if app.user %}
                            <a href="{{ path('app_account_addresses') }}" class="px-3 py-2 rounded-md text-gray-700 hover:text-blue-600 hover:bg-gray-50 transition">My Addresses</a>
                            <div class="hidden md:flex items-center px-2 py-1 text-xs text-gray-500 bg-gray-100 rounded-full">
                                {{ app.user.userIdentifier }}
                            </div>
                            <a href="{{ path('app_logout') }}" class="px-3 py-2 rounded-md text-red-600 hover:text-red-700 hover:bg-red-50 transition">Logout</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="px-3 py-2 rounded-md text-gray-700 hover:text-blue-600 hover:bg-gray-50 transition">Log In</a>
                            <a href="{{ path('app_register') }}" class="px-3.5 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition">Register</a>
                        {% endif %}
                    </nav>
                </div>
            </div>
        </header>

        <!-- Flash Messages -->
        <div class="max-w-4xl mx-auto px-4 sm:px-6 w-full mt-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-3 p-4 rounded-lg text-sm font-medium {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'danger' or label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <!-- Main Content -->
        <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 py-6 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-gray-500">
                &copy; {{ 'now'|date('Y') }} TechBazaar &middot; Electronics &amp; Gadgets &middot; Symfony 8.1
            </div>
        </footer>
    </body>
</html>
