<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TechBazaar{% endblock %}</title>

        <script src="https://cdn.tailwindcss.com"></script>

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">
        {% block header %}
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between shadow-sm">
            <a href="{{ path('app_catalog') }}" class="text-xl font-bold tracking-tight text-slate-900">TechBazaar</a>

            <form action="{{ path('app_catalog') }}" method="GET" class="flex-1 max-w-md mx-8">
                <input type="text" name="q" value="{{ search_query|default('') }}" placeholder="Search products..."
                       class="w-full px-4 py-2 bg-slate-100 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
            </form>

            <div class="flex items-center space-x-4">
                {% if app.user %}
                    <a href="{{ path('app_account_addresses') }}" class="text-sm font-medium hover:underline text-slate-700">My Addresses</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_index') }}" class="text-sm font-semibold text-amber-700 hover:underline">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="text-sm font-medium text-rose-600 hover:underline">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm font-medium hover:underline text-slate-700">Login</a>
                {% endif %}
                <a href="#" class="bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-slate-800 transition">
                    Cart (2)
                </a>
            </div>
        </header>
        {% endblock %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-7xl mx-auto px-4 mt-4 w-full">
                    <div class="p-4 rounded-lg text-sm font-medium {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% else %}bg-red-50 text-red-800 border border-red-200{% endif %}">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="flex-grow">
            {% block body %}{% endblock %}
        </div>

        {% block javascripts %}{% endblock %}
    </body>
</html>
