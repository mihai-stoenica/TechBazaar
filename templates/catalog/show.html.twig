{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-slate-50 text-slate-800">

        {# Top Navigation Bar #}
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between shadow-sm">
            <a href="{{ path('app_catalog') }}" class="text-xl font-bold tracking-tight text-slate-900">TechBazaar</a>

            <form action="{{ path('app_catalog') }}" method="GET" class="flex-1 max-w-md mx-8">
                <input type="text" name="q" placeholder="Search products..."
                       class="w-full px-4 py-2 bg-slate-100 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
            </form>

            <div class="flex items-center space-x-4">
                <a href="#" class="text-sm font-medium hover:underline">Login</a>
                <a href="#" class="bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-slate-800 transition">
                    Cart (2)
                </a>
            </div>
        </header>

        <div class="max-w-7xl mx-auto px-4 py-8">

            <nav class="text-sm text-slate-500 mb-6 flex items-center space-x-2">
                <a href="{{ path('app_catalog') }}" class="hover:underline">Home</a>
                <span>›</span>
                {% if product.category %}
                    <a href="{{ path('app_catalog', {category: product.category.id}) }}" class="hover:underline">{{ product.category.name }}</a>
                    <span>›</span>
                {% endif %}
                <span class="text-slate-800 font-medium">{{ product.name }}</span>
            </nav>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">

                <div class="space-y-4">
                    <div class="w-full h-96 bg-slate-100 border border-slate-200 rounded-xl relative overflow-hidden flex items-center justify-center">
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20">
                            <svg class="w-full h-full text-slate-400" viewBox="0 0 100 100" preserveAspectRatio="none">
                                <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="1"/>
                                <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="1"/>
                            </svg>
                        </div>
                        <span class="text-sm text-slate-400 font-mono">[Main Product Image]</span>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        {% for i in 1..3 %}
                            <div class="h-24 bg-slate-100 border border-slate-200 rounded-lg relative overflow-hidden flex items-center justify-center">
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20">
                                    <svg class="w-full h-full text-slate-400" viewBox="0 0 100 100" preserveAspectRatio="none">
                                        <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="1"/>
                                        <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="1"/>
                                    </svg>
                                </div>
                                <span class="text-xs text-slate-400 font-mono">[Thumb {{ i }}]</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="flex flex-col justify-between space-y-6">
                    <div>
                        <h1 class="text-3xl font-bold text-slate-900 mb-2">{{ product.name }}</h1>
                        <div class="text-2xl font-bold text-slate-900 mb-3">{{ product.price }} RON</div>

                        <div class="mb-6">
                            {% if product.stock > 0 %}
                                <p class="text-sm font-medium text-emerald-600 flex items-center">
                                    <span class="w-2 h-2 bg-emerald-500 rounded-full inline-block mr-2"></span>
                                    In stock ({{ product.stock }} available)
                                </p>
                            {% else %}
                                <p class="text-sm font-medium text-rose-600 flex items-center">
                                    <span class="w-2 h-2 bg-rose-500 rounded-full inline-block mr-2"></span>
                                    Out of stock
                                </p>
                            {% endif %}
                        </div>

                        <form action="#" method="POST" class="flex items-center space-x-4 mb-8">
                            <div class="flex items-center border border-slate-300 rounded-lg px-3 py-2 bg-white">
                                <button type="button" class="text-slate-500 hover:text-slate-900 px-2 font-bold">-</button>
                                <span class="mx-3 text-sm font-semibold">1</span>
                                <button type="button" class="text-slate-500 hover:text-slate-900 px-2 font-bold">+</button>
                            </div>

                            <button type="submit" class="flex-1 bg-slate-900 text-white font-medium px-6 py-3 rounded-lg hover:bg-slate-800 transition shadow-sm">
                                Add to cart
                            </button>
                        </form>

                        <div class="border-t border-slate-200 pt-6 mb-6">
                            <h3 class="text-base font-bold text-slate-900 mb-2">Description</h3>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Experience next-level performance and elegant design with the {{ product.name }}. Built for everyday reliability, power efficiency, and seamless multitasking.
                            </p>
                        </div>

                        <div class="border-t border-slate-200 pt-6">
                            <h3 class="text-base font-bold text-slate-900 mb-2">Specifications</h3>
                            <div class="text-sm text-slate-600 space-y-1">
                                {% if product.specs is iterable and product.specs is not empty %}
                                    <p>
                                        {% for key, value in product.specs %}
                                            <span class="font-medium text-slate-800">{{ key }}:</span> {{ value }}{% if not loop.last %} · {% endif %}
                                        {% endfor %}
                                    </p>
                                {% else %}
                                    <p>Display: 6.1 in · RAM: 8 GB · Storage: 128 GB · Warranty: 24 months</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}
