{% extends 'base.html.twig' %}

{% block body %}
    <div class="min-h-screen bg-slate-50 text-slate-800">


        <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-4 gap-8">

            <aside class="md:col-span-1 space-y-2">
                <h2 class="text-lg font-bold text-slate-900 mb-4 px-3">Categories</h2>
                <nav class="space-y-1">
                    {# "All Categories" optional reset link #}
                    <a href="{{ path('app_catalog') }}"
                       class="block px-3 py-2.5 rounded-lg text-sm font-medium transition
                          {{ active_category is null ? 'bg-amber-100 text-amber-900 border border-amber-300 shadow-sm font-semibold' : 'text-slate-700 hover:bg-slate-200/60' }}">
                        All Products
                    </a>

                    {% for category in categories %}
                        {% set isActive = (category.id == active_category) %}
                        <a href="{{ path('app_catalog', {category: category.id}) }}"
                           class="block px-3 py-2.5 rounded-lg text-sm font-medium transition
                              {{ isActive ? 'bg-amber-100 text-amber-900 border border-amber-300 shadow-sm font-semibold' : 'text-slate-700 hover:bg-slate-200/60' }}">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </nav>
            </aside>

            <main class="md:col-span-3">
                <div class="flex items-center justify-between mb-6">
                    <h1 class="text-2xl font-bold text-slate-900">
                        {% if active_category %}
                            {%- for cat in categories -%}
                                {%- if cat.id == active_category -%}{{ cat.name }}{%- endif -%}
                            {%- endfor -%}
                        {% else %}
                            All Products
                        {% endif %}
                        {% if search_query %}
                            <span class="text-base font-normal text-slate-500">for "{{ search_query }}"</span>
                        {% endif %}
                    </h1>

                    <div class="text-sm text-slate-600 flex items-center space-x-2">
                        <span>Sort: price</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="app_catalog 0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% for product in products %}
                        <div class="bg-white border border-slate-200 rounded-xl p-3 flex flex-col justify-between shadow-xs hover:shadow-md transition">
                            <a href="{{ path('app_product_show', {id: product.id}) }}" >
                                <div>
                                    <div class="w-full h-36 bg-slate-100 border border-slate-200 rounded-lg mb-3 relative overflow-hidden flex items-center justify-center">
                                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20">
                                            <svg class="w-full h-full text-slate-400" viewBox="0 0 100 100" preserveAspectRatio="none">
                                                <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="1"/>
                                                <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="1"/>
                                            </svg>
                                        </div>
                                        <span class="text-xs text-slate-400 font-mono">[Image]</span>
                                    </div>

                                    <h3 class="text-sm font-semibold text-slate-900 leading-snug mb-1">{{ product.name }}</h3>
                                    <p class="text-sm font-bold text-slate-900 mb-2">{{ product.price }} RON</p>
                                </div>
                            </a>
                            <div>
                                {% if product.stock > 0 %}
                                    <p class="text-xs font-medium text-emerald-600 flex items-center">
                                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full inline-block mr-1.5"></span> In stock
                                    </p>
                                {% else %}
                                    <p class="text-xs font-medium text-rose-600 flex items-center">
                                        <span class="w-1.5 h-1.5 bg-rose-500 rounded-full inline-block mr-1.5"></span> Out of stock
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="col-span-full text-center text-slate-500 py-12">No products found matching your criteria.</p>
                    {% endfor %}
                </div>

                <div class="mt-8 text-center text-sm text-slate-600">
                    « Page navigation (max. 24 products per page) »
                </div>
            </main>
        </div>
    </div>
{% endblock %}
