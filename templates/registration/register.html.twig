{% extends 'base.html.twig' %}

{% block title %}Register &middot; TechBazaar{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex flex-col justify-center py-6 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
        <span class="text-4xl">⚡</span>
        <h2 class="mt-3 text-3xl font-extrabold text-gray-900 tracking-tight">Create your account</h2>
        <p class="mt-2 text-sm text-gray-600">
            Already have an account?
            <a href="{{ path('app_login') }}" class="font-medium text-blue-600 hover:text-blue-500">Sign in here</a>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-6 shadow-sm border border-gray-200 rounded-2xl sm:px-10">
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}

                {% if form_errors(registrationForm) %}
                    <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                <div>
                    {{ form_label(registrationForm.email, 'Email address', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm ' ~ (form_errors(registrationForm.email) ? 'border-red-500' : '')
                        }
                    }) }}
                    {% if form_errors(registrationForm.email) %}
                        <div class="mt-1 text-xs text-red-600 font-medium">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm ' ~ (form_errors(registrationForm.plainPassword) ? 'border-red-500' : '')
                        }
                    }) }}
                    {% if form_errors(registrationForm.plainPassword) %}
                        <div class="mt-1 text-xs text-red-600 font-medium">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    {% else %}
                        <p class="mt-1 text-xs text-gray-500">At least 6 characters</p>
                    {% endif %}
                </div>

                <div>
                    <button type="submit"
                            class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">
                        Register Account
                    </button>
                </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}
